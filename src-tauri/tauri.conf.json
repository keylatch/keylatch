{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keylatch",
  "version": "0.9.3",
  "identifier": "com.keylatch.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:7890",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APP/**", "$RESOURCE/**"]
      },
      "capabilities": ["keylatch-default"]
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Keylatch Contributors",
    "category": "Utility",
    "copyright": "Copyright 2024 Keylatch Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [
      "binaries/keylatchd"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "entitlements": "../packaging/macos/Keylatch.entitlements",
      "signingIdentity": null,
      "providerShortName": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "https://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37", "libappindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["keylatch"]
      }
    },
    "single-instance": {},
    "updater": {
      "active": false,
      "endpoints": [
        "https://releases.keylatch.app/manifest/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzM0QxM0FEODUzRkY0QTAKUldTZzlEK0ZyUk05dy9oYVExVEdzNm1Pd1hYc2l6d21JQkt4NEtKM3VwVXhrdTIvNlg3bzBCRnUK"
    },
    "shell": {
      "open": "^((mailto:\\w+)|(https?://\\w+)|keylatch://)"
    },
    "log": {
      "level": "info",
      "targets": [
        { "kind": "Stdout" },
        { "kind": "LogDir", "fileName": "keylatch-app" }
      ]
    },
    "notification": {
      "permissions": []
    }
  }
}
