{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://keylatch.dev/schemas/migrate-map.schema.json",
  "title": "Keylatch migrate map",
  "description": "Where 'keylatch migrate inventory' looks for secrets and which namespace each source lands in.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": {"const": 1},
    "collections": {
      "description": "Namespace to backend collection.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/source"}
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "namespace"],
      "properties": {
        "type": {"enum": ["env-file", "secret-service", "keychain", "gh", "password-manager"]},
        "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "glob": {"type": "string", "minLength": 1},
        "service": {"type": "string", "minLength": 1},
        "accounts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "manager": {"enum": ["bw", "op"]},
        "items": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "hosts": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "env-file"}}}, "then": {"required": ["glob"]}},
        {"if": {"properties": {"type": {"const": "secret-service"}}}, "then": {"required": ["service"]}},
        {"if": {"properties": {"type": {"const": "keychain"}}}, "then": {"required": ["service", "accounts"]}},
        {"if": {"properties": {"type": {"const": "password-manager"}}}, "then": {"required": ["manager", "items"]}}
      ]
    }
  }
}
