{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://keylatch.dev/schemas/sync.schema.json",
  "title": "Keylatch sync manifest",
  "description": "keylatch.sync.yaml: which connection feeds which variable of which deploy target. 'keylatch sync check' also enforces the rules a schema cannot express: environments per target type, sensitive variables in Vercel development, GitHub secret names, duplicate declarations and git-ignored env files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets", "vars"],
  "properties": {
    "version": {"const": 1},
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/definitions/target"}
    },
    "vars": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/var"}
    }
  },
  "definitions": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["vercel", "github-actions", "env-file"]},
        "project": {"type": "string", "minLength": 1},
        "team": {"type": "string", "minLength": 1},
        "link": {"type": "string", "minLength": 1},
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "environments": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "path": {"type": "string", "minLength": 1},
        "credential": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "vercel"}}},
          "then": {
            "required": ["credential"],
            "oneOf": [{"required": ["project"]}, {"required": ["link"]}],
            "not": {"anyOf": [{"required": ["repo"]}, {"required": ["path"]}, {"required": ["environments"]}]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "github-actions"}}},
          "then": {
            "required": ["repo", "credential"],
            "not": {"anyOf": [{"required": ["project"]}, {"required": ["team"]}, {"required": ["link"]}, {"required": ["path"]}]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "env-file"}}},
          "then": {
            "required": ["path"],
            "not": {"anyOf": [{"required": ["project"]}, {"required": ["team"]}, {"required": ["link"]}, {"required": ["repo"]}, {"required": ["credential"]}, {"required": ["environments"]}]}
          }
        }
      ]
    },
    "var": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from", "to"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connection"],
          "properties": {
            "connection": {"type": "string", "minLength": 1},
            "field": {"type": "string", "minLength": 1}
          }
        },
        "sensitive": {"type": "boolean"},
        "to": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {"url": {"type": "string", "pattern": "^https://"}}
        }
      }
    }
  }
}
