{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://keylatch.dev/schemas/migrate-plan.schema.json",
  "title": "Keylatch migrate plan",
  "description": "The inventory 'keylatch migrate inventory' prints and 'keylatch migrate import' reads. Names, references and target paths only; never a value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": {"const": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "ref", "namespace", "path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "namespace": {"type": "string", "minLength": 1},
          "collection": {"type": "string"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
