<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.keylatch.presence</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/keylatch/Keylatch Presence.app/Contents/MacOS/keylatch-presence</string>
    <string>serve</string>
    <string>--socket</string>
    <string>/var/db/keylatch/run/broker.sock</string>
  </array>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
</dict>
</plist>
