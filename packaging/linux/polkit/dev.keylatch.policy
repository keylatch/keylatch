<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Keylatch</vendor>
  <vendor_url>https://github.com/keylatch/keylatch</vendor_url>

  <!-- auth_self asks for the calling user's own password every time; nothing is retained. -->
  <action id="dev.keylatch.privileged">
    <description>Approve a privileged Keylatch action</description>
    <message>Authentication is required to approve a privileged Keylatch action</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
