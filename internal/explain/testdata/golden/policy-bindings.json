{
  "schema_version": 1,
  "kind": "policy",
  "policy": {
    "mode": "enforcing",
    "default_deny": true,
    "rule_count": 1
  },
  "callers": [
    {
      "actor": "claude-code",
      "caller_kind": "agent",
      "connections": [
        {
          "connection": "billing-internal",
          "known": true,
          "hosts": [
            "api.billing.example:443"
          ],
          "binding": {
            "source": "custom",
            "hosts": [
              "api.billing.example:443"
            ],
            "slots": [
              {
                "field": "token",
                "in": "header",
                "name": "Authorization",
                "hosts": [
                  "api.billing.example:443"
                ]
              }
            ]
          },
          "tiers": [
            {
              "tier": "D1",
              "tier_name": "typed_action",
              "status": "unavailable",
              "runtime": "",
              "restricted": false,
              "why": "typed actions run without a child process; use keylatch call"
            },
            {
              "tier": "D2",
              "tier_name": "gateway_session",
              "status": "unavailable",
              "runtime": "",
              "restricted": false,
              "why": "runtime gateway_typed is not supported in this build; runtime gateway_sdk is not supported in this build"
            },
            {
              "tier": "D3",
              "tier_name": "placeholder_substitution",
              "status": "allowed",
              "runtime": "placeholder",
              "restricted": false,
              "why": "permitted by policy rule r1"
            },
            {
              "tier": "D4",
              "tier_name": "protocol_adapter",
              "status": "unavailable",
              "runtime": "",
              "restricted": false,
              "why": "runtime adapter is not supported in this build"
            },
            {
              "tier": "D5",
              "tier_name": "contained_raw",
              "status": "allowed",
              "runtime": "contained",
              "restricted": false,
              "why": "permitted by policy rule r1"
            },
            {
              "tier": "D6",
              "tier_name": "uncontained_raw",
              "status": "denied",
              "runtime": "",
              "restricted": false,
              "why": "uncontained raw delivery is human-only"
            }
          ]
        }
      ]
    }
  ],
  "notes": [
    "rules limited by command or working directory are reported as restricted; use explain run for an exact answer"
  ]
}
