{
  "description": "both tiers eligible, the stronger one wins",
  "mode": "run",
  "policy": {
    "schema_version": 1,
    "mode": "enforcing",
    "default_deny": true,
    "rules": [
      {
        "id": "r1",
        "actor": "*",
        "connections": [
          "openai"
        ],
        "capabilities": [
          "inject"
        ]
      }
    ]
  },
  "connection": {
    "known": true,
    "provider": "openai",
    "hosts": [
      "api.openai.com"
    ],
    "runtimes": [
      "gateway_typed"
    ],
    "typed_actions": true,
    "binding": {
      "source": "template",
      "hosts": ["api.openai.com"],
      "slots": [{"field": "api_key", "in": "header", "name": "Authorization", "hosts": ["api.openai.com"]}]
    }
  },
  "enabled_runtimes": [
    "gateway_typed",
    "placeholder"
  ],
  "request": {
    "actor": "claude-code",
    "llm_session": true,
    "connection": "openai",
    "argv": [
      "pnpm",
      "test"
    ],
    "cwd": "/work/app",
    "tier": ""
  }
}
