{
  "description": "permissive mode is fine for a human",
  "mode": "run",
  "policy": {
    "schema_version": 1,
    "mode": "permissive",
    "default_deny": false,
    "rules": []
  },
  "connection": {
    "known": true,
    "provider": "openai",
    "hosts": [
      "api.openai.com"
    ],
    "runtimes": [
      "gateway_typed",
      "gateway_sdk"
    ],
    "typed_actions": true
  },
  "enabled_runtimes": [
    "gateway_typed",
    "gateway_sdk"
  ],
  "request": {
    "actor": "human-shell",
    "llm_session": false,
    "connection": "openai",
    "argv": [
      "pnpm",
      "test"
    ],
    "cwd": "/work/app",
    "tier": ""
  }
}
