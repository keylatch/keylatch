{
  "description": "argv with spaces and a token-like argument is only digested",
  "mode": "run",
  "policy": {
    "schema_version": 1,
    "mode": "enforcing",
    "default_deny": false,
    "rules": []
  },
  "connection": {
    "known": true,
    "provider": "openai",
    "hosts": [
      "api.openai.com"
    ],
    "runtimes": [
      "gateway_typed",
      "gateway_sdk"
    ],
    "typed_actions": true
  },
  "enabled_runtimes": [
    "gateway_typed",
    "gateway_sdk"
  ],
  "request": {
    "actor": "human-shell",
    "llm_session": false,
    "connection": "openai",
    "argv": [
      "curl",
      "-H",
      "Authorization: Bearer sk-live-not-printed",
      "https://api.openai.com"
    ],
    "cwd": "/work/app",
    "tier": ""
  }
}
