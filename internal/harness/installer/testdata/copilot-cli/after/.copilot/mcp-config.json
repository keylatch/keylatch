{
  "mcpServers": {
    "other-server": {
      "type": "local",
      "command": "npx",
      "args": [
        "other-server"
      ],
      "tools": [
        "*"
      ]
    },
    "keylatch": {
      "type": "local",
      "command": "/opt/keylatch/bin/keylatch",
