        "url": "https://github.com/keylatch/keylatch/releases/download/v$version/keylatch_$version_windows_amd64.zip"
      },
      "arm64": {
        "url": "https://github.com/keylatch/keylatch/releases/download/v$version/keylatch_$version_windows_arm64.zip"
